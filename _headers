# Cloudflare Pages response headers, read from the output directory (the repo root).
# Rules: one path pattern, then indented "Name: value" lines. Max 100 rules, 2000 chars per line.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The de-google presentation in /degoogle/ is one self-contained file: its CSS and JS are
# inline, and the site-wide style-src 'self' would block them. This path swaps in the same
# policy with inline styles and scripts allowed, nothing else relaxed. The deck fetches
# nothing over the network, so 'self' covers every subresource it loads. A detach line
# removes the value the /* rule above put there: order in this file is load-bearing.
# It is also kept out of search indexes: the deck is deliberately unlinked, reachable only
# by direct URL, and a recipient sharing it should not pull it into Google.
/degoogle/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Robots-Tag: noindex

# Every page is served from this one origin, so a cross-origin embed of og.png would need
# Cross-Origin-Resource-Policy. It is deliberately not set: social crawlers fetch the image
# as a top-level navigation, and a same-origin policy here would break link previews.

# The production origin is the project domain itself. Every deploy also gets a per-deploy
# hash subdomain, and those previews must never be indexed next to the canonical URLs.
# A host placeholder matches one label, so this hits the hash subdomains but not the
# production apex; two wildcards in one rule would be rejected and silently skipped.
https://:subdomain.bouallegui.pages.dev/*
  X-Robots-Tag: noindex

# Fonts are latin subsets that change a couple of times a year, and the images are content,
# not code: both can sit in a browser cache for a month without anyone waiting on a rebuild.
/fonts/*
  Cache-Control: public, max-age=2592000
/images/*
  Cache-Control: public, max-age=2592000

# css/output.css and js/*.js keep their names across edits, so they get a week, not a year.
/css/*
  Cache-Control: public, max-age=604800
/js/*
  Cache-Control: public, max-age=604800
