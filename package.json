{
  "name": "bouallegui",
  "version": "1.0.0",
  "description": "Ahmed Taha Bouallegui - Cybersecurity and systems done right. Portfolio + blog static site.",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -i src/input.css -o css/output.css --watch",
    "build": "tailwindcss -i src/input.css -o css/output.css --minify",
    "hero": "esbuild src/hero.js --bundle --format=esm --minify --target=es2020 --outfile=js/vendor/hero.bundle.js",
    "serve": "node scripts/serve.mjs",
    "check": "sh scripts/check-links.sh",
    "feed": "node scripts/build-feed.mjs",
    "partials": "node scripts/render-partials.mjs"
  },
  "keywords": [
    "portfolio",
    "cybersecurity",
    "tailwindcss",
    "personal website"
  ],
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.27.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "three": "0.186.1"
  }
}
