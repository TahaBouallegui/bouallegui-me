# Cloudflare Pages redirects, read from the output directory (the repo root).
# Max 2000 static rules and 100 dynamic ones.
# Docs: https://developers.cloudflare.com/pages/configuration/redirects/

# Canonical URLs are the apex only, on every page and in feed.xml, so www has to 301 to it.
# This rule only takes effect once bouallegui.me is attached to the Pages project and www
# is a DNS record on the same host.
https://www.bouallegui.me/*  https://bouallegui.me/:splat  301

# The canonical form of the two index pages is the directory, but the nav links to the file
# names, so the file names have to collapse onto the canonical URLs instead of duplicating them.
/index.html  /  301
/fr/index.html  /fr/  301
